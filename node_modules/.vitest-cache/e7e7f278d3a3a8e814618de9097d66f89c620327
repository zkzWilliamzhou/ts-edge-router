//# vitestSourceMap={"mappings":"","names":[],"sources":["types.ts"],"version":3,"sourcesContent":["/**\n * Type definitions for ts-edge-router\n */\n\nexport type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';\n\nexport type ExtractPathParams<P extends string> = \n  P extends `${string}:${infer Name}`\n    ? Name\n    : never;\n\nexport interface RouteContext {\n  request: Request;\n  env: Record<string, string>;\n  waitUntil?: (promise: Promise<void>) => void;\n}\n\nexport type RouteHandler = (\n  params: Record<string, unknown>,\n  context: RouteContext\n) => Promise<void>;\n\nexport interface RouteDefinition {\n  method: HttpMethod;\n  path: string;\n  handler: RouteHandler;\n}\n\nexport type RouteCollection = Record<string, RouteDefinition>;\n\nexport interface CompiledRoute {\n  method: HttpMethod;\n  pattern: RegExp;\n  paramNames: string[];\n  handler: RouteHandler;\n}\n\nexport interface EdgeConfig {\n  routes: CompiledRoute[];\n  entrypoint: string;\n}\n"]}