//# vitestSourceMap={"mappings":"","names":[],"sources":["types.ts"],"version":3,"sourcesContent":["/**\n * Type definitions for ts-edge-router\n * Compile-time validated edge routing for TypeScript\n */\n\n// HTTP methods supported\nexport type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';\n\n// Path parameter extraction - compile-time safe\n// Extracts parameter names from path patterns like '/users/:id' -> 'id'\nexport type ExtractPathParams<P extends string> = \n  P extends `${string}:${infer Name}/${infer Rest}`\n    ? Name | ExtractPathParams<Rest>\n    : P extends `${string}:${infer Name}`\n      ? Name\n      : never;\n\n// Context provided to route handlers\nexport interface RouteContext {\n  request: Request;\n  env: Record<string, string>;\n  waitUntil?: (promise: Promise<void>) => void;\n}\n\n// Route handler function type\n// @template P - Extracted path parameters\n// @template R - Response type\nexport type RouteHandler<P = Record<string, string>, R = unknown> = (\n  params: P & { [K in ExtractPathParams<string>]: string | number } & Record<string, unknown>,\n  context: RouteContext\n) => Promise<R>;\n\n// Single route definition\nexport interface RouteDefinition<P = Record<string, string>, R = unknown> {\n  method: HttpMethod;\n  path: string;\n  handler: RouteHandler<P, R>;\n}\n\n// Collection of routes keyed by 'METHOD /path' string\nexport type RouteCollection = Record<string, RouteDefinition>;\n\n// Compiled route at runtime\nexport interface CompiledRoute<R = unknown> {\n  method: HttpMethod;\n  pattern: RegExp;\n  paramNames: string[];\n  handler: RouteHandler<Record<string, string>, R>;\n}\n\n// Output configuration for edge deployment\nexport interface EdgeConfig {\n  routes: CompiledRoute[];\n  entrypoint: string;\n}\n"]}