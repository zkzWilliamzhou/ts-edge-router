//# vitestSourceMap={"mappings":"","names":[],"sources":["types.ts"],"version":3,"sourcesContent":["/**\n * Type definitions for ts-edge-router\n * Compile-time validated edge routing for TypeScript\n */\n\n// Route method types\nexport type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH' | 'HEAD' | 'OPTIONS';\n\n// Parameter constraint types\nexport type StringParams = string;\nexport type NumberParams = number;\nexport type BooleanParams = boolean;\n\n// Path parameter extraction - compile-time safe\nexport type ExtractPathParams<P extends string> = \n  P extends `${infer _Start}:${infer Name}/${infer Rest}`\n    ? Name | ExtractPathParams<Rest>\n    : P extends `${infer _Start}:${infer Name}`\n      ? Name\n      : never;\n\n// Route handler types\nexport type RouteHandler<T = unknown, R = unknown> = (params: T, context: Context) => Promise<R>;\n\nexport interface Context {\n  request: Request;\n  env: Record<string, string>;\n  waitUntil?: (promise: Promise<void>) => void;\n  passToSocket?: (socket: unknown) => void;\n}\n\n// Route definition type\nexport interface RouteDefinition<T = unknown, R = unknown> {\n  method: HttpMethod;\n  path: string;\n  handler: RouteHandler<T, R>;\n}\n\n// Collection of routes\nexport type RouteCollection = Record<string, RouteDefinition>;\n\n// Compiled route output type\nexport interface CompiledRoute {\n  method: HttpMethod;\n  pattern: RegExp;\n  handler: RouteHandler;\n}\n\n// Edge config output type\nexport interface EdgeConfig {\n  routes: CompiledRoute[];\n  entrypoint: string;\n}\n"]}